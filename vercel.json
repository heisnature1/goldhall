{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "memory": 1024
    },
    "api/content.php": {
      "runtime": "vercel-php@0.9.0",
      "memory": 1024
    },
    "api/admin-content.php": {
      "runtime": "vercel-php@0.9.0",
      "memory": 1024
    },
    "api/auth-config.php": {
      "runtime": "vercel-php@0.9.0",
      "memory": 1024
    },
    "api/portal.php": {
      "runtime": "vercel-php@0.9.0",
      "memory": 1024
    },
    "api/sitemap.php": {
      "runtime": "vercel-php@0.9.0",
      "memory": 1024
    }
  },
  "redirects": [
    {
      "source": "/index.php",
      "destination": "/index",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/index",
      "permanent": false
    },
    {
      "source": "/about.php",
      "destination": "/about",
      "permanent": false
    },
    {
      "source": "/executives.php",
      "destination": "/executives",
      "permanent": false
    },
    {
      "source": "/events.php",
      "destination": "/events",
      "permanent": false
    },
    {
      "source": "/gallery.php",
      "destination": "/gallery",
      "permanent": false
    },
    {
      "source": "/contact.php",
      "destination": "/contact",
      "permanent": false
    },
    {
      "source": "/students.php",
      "destination": "/students",
      "permanent": false
    },
    {
      "source": "/student.php",
      "destination": "/student",
      "permanent": false
    },
    {
      "source": "/dashboard.php",
      "destination": "/dashboard",
      "permanent": false
    },
    {
      "source": "/admin.php",
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/reset-password.php",
      "destination": "/reset-password",
      "permanent": false
    },
    {
      "source": "/confirm-email.php",
      "destination": "/confirm-email",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.php"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/sitemap.php?type=robots"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/api/index.php"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.php",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
