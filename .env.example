# Gold Hall — administrator sign-in.
# Copy to .env (or set as real environment variables on your host) and change
# the password before going live. The defaults below are the old preview login
# so nothing breaks on first run, but they are public knowledge.
GOLDHALL_ADMIN_USER=admin
GOLDHALL_ADMIN_PASSWORD=goldhall

# Where PHP stores sessions. On shared hosting the default is usually fine.
# session.save_path=/var/lib/php/sessions
