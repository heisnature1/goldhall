# Gold Hall — administrator sign-in.
# Copy to .env (or set as real environment variables on your host) and change
# the password before going live. The defaults below are the old preview login
# so nothing breaks on first run, but they are public knowledge.
GOLDHALL_ADMIN_USER=admin
GOLDHALL_ADMIN_PASSWORD=goldhall

# Where PHP stores sessions. On shared hosting the default is usually fine.
# session.save_path=/var/lib/php/sessions

# ---------------------------------------------------------------------------
# Supabase (content storage)
# ---------------------------------------------------------------------------
# Needed on hosts where PHP cannot write files — Vercel is the important one.
# Leave both unset and the site keeps using data/content.json, so local
# development and plain shared hosting work with no setup at all.
#
#   1. Create a project at supabase.com.
#   2. SQL Editor → run supabase-schema.sql (creates the table + storage bucket).
#   3. Project Settings → API → copy the Project URL and the service_role key.
#   4. Add them as environment variables on the host (Vercel: Settings →
#      Environment Variables), then redeploy.
#
# The service_role key can write to every table, so it stays server-side only:
# never in the repo, never in JavaScript, never in a screenshot.
# GOLDHALL_SUPABASE_URL=https://your-project-ref.supabase.co
# GOLDHALL_SUPABASE_KEY=your-service-role-key
# GOLDHALL_SUPABASE_BUCKET=uploads
